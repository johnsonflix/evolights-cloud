# Copy to .env and fill in. Never commit .env.
#
# Most non-secret variables here are FIRST-BOOT DEFAULTS. Once the api comes
# up, an admin can override them at runtime via the admin UI (Settings page);
# values stored in the app_settings table take precedence over what's in this
# file. Genuinely secret values (JWT_SECRET, DATABASE_URL, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, MQTT_API_PASSWORD, OTA_SIGNING_KEY_PATH, POSTGRES_*)
# remain env-only -- those are not exposed in the admin UI.

# --- API ---
NODE_ENV=development
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
PAIRING_CODE_TTL_SECONDS=300

# Public URL of the web app — used to build links in transactional emails.
PUBLIC_WEB_URL=https://app.evolights.io

# Optional. Product brand name used in email subjects and the admin header.
# Defaults to "EvoLights" if unset. Also editable at runtime via the admin
# UI (Settings -> Branding), which overrides this env value.
# BRAND_NAME=EvoLights

# --- Postgres ---
POSTGRES_USER=evolights
POSTGRES_PASSWORD=change-me
POSTGRES_DB=evolights
DATABASE_URL=postgres://evolights:change-me@postgres:5432/evolights

# --- MQTT ---
MQTT_URL=mqtt://mosquitto:1883
MQTT_API_USERNAME=api
MQTT_API_PASSWORD=change-me

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_MONTHLY=price_replace_me
# Optional: monthly subscription unit price in cents — used for the admin
# /v1/admin/stats MRR estimate. If unset, mrr_cents returns null.
# STRIPE_PRICE_AMOUNT_CENTS=999

# --- OTA signing ---
# Path inside the api container to the Ed25519 private key used to sign firmware manifests.
# Generate: openssl genpkey -algorithm ed25519 -out ota-signing.key
OTA_SIGNING_KEY_PATH=/run/secrets/ota-signing.key

# --- Email (transactional sender) ---
# Pick one provider. If unset, password-reset and any other email-dependent
# endpoints will return 503. Both providers can be configured at the same time
# but EMAIL_PROVIDER chooses which one is active.
# EMAIL_PROVIDER=smtp                  # smtp | graph
# EMAIL_FROM="EvoLights <noreply@evolights.io>"

# --- SMTP (works with SES/Mailgun/SendGrid/Gmail App Password/own server) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false                    # true for 465 (TLS), false for 587 (STARTTLS)
# SMTP_USER=
# SMTP_PASS=

# --- Microsoft Graph (Azure AD app, client-credentials flow) ---
# Requires an Azure AD app registration with Mail.Send APPLICATION permission
# (admin-consented). Mailbox specified by GRAPH_SENDER_UPN.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER_UPN=user@yourdomain.com

# --- Sign in with Apple ---
# The "Services ID" registered in your Apple Developer account, used as `aud`
# in id_tokens we'll verify. iOS apps usually use the bundle ID instead; set
# accordingly to whichever is the audience your front-end requests.
# APPLE_CLIENT_ID=com.evolights.app

# --- Sign in with Google ---
# OAuth 2.0 client IDs from Google Cloud Console — one per platform.
# Tokens issued for any of these audiences will be accepted by the verifier.
# At least one must be set for /v1/auth/google to be enabled.
# GOOGLE_CLIENT_ID_IOS=
# GOOGLE_CLIENT_ID_ANDROID=
# GOOGLE_CLIENT_ID_WEB=
