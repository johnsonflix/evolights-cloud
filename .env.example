# Copy to .env and fill in. Never commit .env.

# --- API ---
NODE_ENV=development
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
PAIRING_CODE_TTL_SECONDS=300

# Public URL of the web app — used to build links in transactional emails.
PUBLIC_WEB_URL=https://app.evolights.io

# --- Postgres ---
POSTGRES_USER=evolights
POSTGRES_PASSWORD=change-me
POSTGRES_DB=evolights
DATABASE_URL=postgres://evolights:change-me@postgres:5432/evolights

# --- MQTT ---
MQTT_URL=mqtt://mosquitto:1883
MQTT_API_USERNAME=api
MQTT_API_PASSWORD=change-me

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_MONTHLY=price_replace_me

# --- OTA signing ---
# Path inside the api container to the Ed25519 private key used to sign firmware manifests.
# Generate: openssl genpkey -algorithm ed25519 -out ota-signing.key
OTA_SIGNING_KEY_PATH=/run/secrets/ota-signing.key

# --- Email (transactional sender) ---
# Pick one provider. If unset, password-reset and any other email-dependent
# endpoints will return 503. Both providers can be configured at the same time
# but EMAIL_PROVIDER chooses which one is active.
# EMAIL_PROVIDER=smtp                  # smtp | graph
# EMAIL_FROM="EvoLights <noreply@evolights.io>"

# --- SMTP (works with SES/Mailgun/SendGrid/Gmail App Password/own server) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false                    # true for 465 (TLS), false for 587 (STARTTLS)
# SMTP_USER=
# SMTP_PASS=

# --- Microsoft Graph (Azure AD app, client-credentials flow) ---
# Requires an Azure AD app registration with Mail.Send APPLICATION permission
# (admin-consented). Mailbox specified by GRAPH_SENDER_UPN.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER_UPN=user@yourdomain.com
